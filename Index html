function montar(seg, obj, fmt, tom, produto, cliente, nomeCamp) {
  const sg = CSEG[seg]; const pr = produto.trim() || "o nosso serviço";
  const oi = COBJ.indexOf(obj); const k = seg + "|" + tom + "|" + oi + "|";
  const res = sorteia(k + "res", sg.desejos);
  const raw = (cliente || "").trim().replace(/[.\s]+$/, "");
  const pub = raw ? baixa(cortar(raw, 80)) : "quem acompanha o seu trabalho";
  const gancho = limpar(subst(sorteia(k + "g", GANCHOS_TOM[tom]), { prod: pr, pub, res }));
  const dor = sorteia(seg + "|dor", sg.dores);
  const objecao = sorteia(seg + "|obj", sg.objecoes);
  const mito = sorteia(seg + "|mito", sg.mitos);
  const prova = sorteia(seg + "|prova", sg.provas);
  const cta = sorteia(k + "cta", CTAS_OBJ[oi]);
  const icp = raw ? sorteia(seg + "|icp", ICP_LINHAS)(pub) : "";
  const oferta = "Com " + pr + ", você chega a " + res + ". " + OFERTA_OBJ[oi];
  let blocos = [];
  if (fmt === "reels") {
    const ofertaCurta = "Com " + pr + ", você chega a " + res + ".";
    const mk = (o) => [["Gancho", gancho], ["Dor e identificação", dor + (o.icp && icp ? " " + icp : "")], ["Quebra de objeção", objecao + (o.mito ? " " + mito : "")], ["Solução e oferta", o.curta ? ofertaCurta : oferta], ...(o.prova ? [["Autoridade e segurança", prova]] : []), ["Chamada para ação", cta]];
    const dd = (bl) => bl.reduce((t, b) => t + nPal(b[1]), 0) / 2.9;
    const passos = [{ icp: true, mito: true, prova: true }, { icp: true, mito: true }, { icp: true }, {}, { curta: true }];
    let dorX = sorteia(seg + "|dorX", sg.dores);
    if (dorX === dor) dorX = sg.dores[(sg.dores.indexOf(dor) + 1) % sg.dores.length];
    const cands = [];
    passos.forEach(o => { const base = mk(o); cands.push(base); const x = [...base]; x.splice(3, 0, ["Ângulo extra", dorX]); cands.push(x); if (!o.mito) { const y = [...base]; y.splice(3, 0, ["Mito e verdade", mito]); cands.push(y); } });
    let bd = 1e9; cands.forEach(c => { const e = dd(c); const dist = e < 35 ? 35 - e : e > 40 ? e - 40 : Math.abs(e - 37.5) * 0.01; if (dist < bd) { bd = dist; blocos = c; } });
  } else if (fmt === "stories") {
    let b2 = dor + " " + oferta;
    if ((nPal(gancho) + nPal(b2) + nPal(cta)) / 2.9 < 21) b2 += " " + prova;
    if ((nPal(gancho) + nPal(b2) + nPal(cta)) / 2.9 < 21 && icp) b2 += " " + icp;
    blocos = [["Gancho", gancho], ["Dor e solução", b2], ["Chamada para ação", cta]];
  } else {
    blocos = [["Capa", gancho], ["Dor", dor], ["Mito e verdade", mito], ["Objeção", objecao], ["Solução", oferta], ["Segurança", prova], ["Chamada para ação", cta]];
  }
  blocos = blocos.map(b => [b[0], limpar(b[1])]);
  const palavras = blocos.reduce((t, b) => t + nPal(b[1]), 0);
  const dur = Math.round(palavras / 2.9);
  let roteiro;
  if (fmt === "carrossel") roteiro = blocos.map((b, i) => ({ t: "Slide " + (i + 1), b: b[0], x: b[1] }));
  else { let acc = 0; roteiro = blocos.map(b => { const ini = Math.round(acc); acc += nPal(b[1]) / 2.9; return { t: ini + "-" + Math.round(acc) + "s", b: b[0], x: b[1] }; }); }
  const balao = gerarNotas(seg, obj, tom, produto, cliente, 1)[0];
  const textoRoteiro = roteiro.map(r => r.t + " | " + r.b + "\n" + r.x).join("\n\n");
  const hash = "#" + sg.n.replace(/[^A-Za-zÀ-ú]/g, "").toLowerCase();
  const ctaLeg = oi === 3 ? "Salva este post e me segue para mais conteúdo assim." : oi === 1 ? "Ficou com dúvida? Me chama no Direct e eu te explico." : "Quer saber mais? Clique no link da bio ou chame no Direct.";
  const legenda = limpar(gancho + "\n\n" + dor + (icp ? "\n\n" + icp : "") + "\n\n" + oferta + "\n\n👉 " + ctaLeg + "\n\n" + hash + " #atendimento #vendas");
  return { titulo: tituloCampanha(nomeCamp, obj, seg, fmt), gancho, roteiro, textoRoteiro, balao, legenda, palavras, dur, fmt, saude: sg.saude, urg: tom === 2 };
}

