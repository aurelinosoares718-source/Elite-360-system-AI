  const T = pos(v.t), M = pos(v.m), CPL = pos(v.cpl), convRaw = pos(v.conv);
  const CONV = convRaw > 0 ? Math.min(100, Math.max(0.1, convRaw)) : 0;
  const avisoConv = convRaw > 100 ? "A taxa de conversão é limitada a 100% no cálculo." : convRaw > 0 && convRaw < 0.1 ? "A taxa de fechamento mínima considerada é 0,1%." : "";
  const vendas = T > 0 && CONV > 0 ? ok(Math.ceil(M / T)) : 0;
  const leadsN = T > 0 && CONV > 0 ? ok(Math.ceil(vendas / (CONV / 100))) : 0;
  const invest = ok(leadsN * CPL), cac = vendas > 0 ? ok(invest / vendas) : 0, roas = invest > 0 ? ok(M / invest) : 0, saldo = isFinite(M - invest) ? M - invest : 0;
  const pronto = vendas > 0 && leadsN > 0;
