      : [nm ? `Olá, ${nm}, tudo bem?` : "Olá, tudo bem?", nm ? `Olá ${nm}, espero que esteja bem.` : "Olá, espero que esteja bem."];
  return sorteia("oiObj|" + tom, L);
}
