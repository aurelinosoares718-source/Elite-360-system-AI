            <input className={field + " sm:col-span-2"} type="number" min="0" inputMode="decimal" placeholder="Valor fechado (R$)" value={r.valor} onChange={e => setR({ ...r, valor: e.target.value })} />
          </div>
          <button onClick={addR} className="mt-3 rounded-xl border border-[#D4AF37]/50 px-5 py-2.5 text-xs font-bold text-[#D4AF37]">Registrar</button>
        </div>
      </div>
      <div className="mt-4 grid gap-3 lg:grid-cols-2">
