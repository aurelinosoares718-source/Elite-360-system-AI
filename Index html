          </div>
          {dr.tem && <><div><label className={lbl}>Quantidade de pessoas</label><input className={field} inputMode="numeric" value={dr.qtdTxt} onChange={set("qtdTxt")} placeholder="Ex: 3" /></div>
          <div><label className={lbl}>Folha salarial total (R$/mês)</label><input className={field} inputMode="decimal" value={dr.folhaTxt} onChange={set("folhaTxt")} placeholder="Ex: 6000" /></div></>}
          <p className="sm:col-span-2 text-xs text-gray-500">O Lucro Operacional Real desconta margem dos serviços, despesas fixas e folha.</p>
        </div>)}

      <label className="mt-4 flex items-center gap-2 text-sm text-gray-300 cursor-pointer"><input type="checkbox" className="accent-[#39FF14] w-4 h-4" checked={perfil.som !== false} onChange={e => onSave({ som: e.target.checked })} />Som de venda (tlim) ao registrar venda</label>
