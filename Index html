// Analisa o texto livre por palavras-chave e devolve situação + sinais extras
function analisar(txt) {
  const t = txt.toLowerCase();
  const has = (re) => re.test(t);
  let sit = 0, motivo = "";
  const terceiro = has(/marido|espos|namorad|companheir|ver com (o|a) /);
  if (has(/caro|car[ií]ssimo|pensar|desconto|n[aã]o cabe|or[cç]amento|apertado/)) { sit = 2; motivo = "objeção de preço"; }
  else if (has(/sum(iu|iram)|v[aá]cuo|n[aã]o (responde|respondeu)|visualiz|parou de responder|silêncio/)) { sit = 1; motivo = "lead sem resposta"; }
  else if (has(/antig|inativ|faz (muito )?tempo|voltar|base|reativ/)) { sit = 4; motivo = "lead antigo/inativo"; }
  else if (has(/agendar|marcar|data|hor[aá]rio|dia |semana|n[aã]o sei se|hesit/)) { sit = 3; motivo = "hesitação de agenda"; }
  else if (has(/pre[cç]o|quanto|valor|custa|investimento/)) { sit = 0; motivo = "pedido de preço"; }
  else { sit = 0; motivo = "contexto geral"; }
  return { sit, motivo, terceiro };
}

