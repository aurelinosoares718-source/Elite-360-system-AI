  if (!rec) {
    if (produto) {
      const risco = d.estoque.filter(i => i.qtd <= 0 || i.qtd <= i.min).length;
      cards.push(cartao("estoque", "Estoque", I.boxEl, risco + " em risco", d.estoque.length + (d.estoque.length === 1 ? " produto" : " produtos") + " cadastrados", risco ? "Reposição necessária" : "", risco ? "#f87171" : NEON));
