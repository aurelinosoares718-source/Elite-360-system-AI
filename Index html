            <p className="mt-1 text-sm font-semibold" style={{ color: NEON }}>{brl(x.valor)}</p>
            {x.mb.meta > 0 && <div className="mt-2"><div className="h-2 w-full overflow-hidden rounded-full bg-[#27272a]"><div className="h-full rounded-full" style={{ width: pct + "%", background: NEON }} /></div><p className="mt-1 text-[11px] text-gray-500">{Math.round(x.mb.meta > 0 ? x.valor / x.mb.meta * 100 : 0)}% da meta de {brl(x.mb.meta)}</p></div>}
            <button onClick={() => { if (confirmaExcluir()) upd(t => ({ membros: t.membros.filter(y => y.id !== x.mb.id), reg: t.reg.filter(y => y.membro !== x.mb.id) })); }} className="mt-3 rounded-lg border border-[#27272a] px-3 py-1.5 text-xs text-gray-500 hover:text-red-400">Excluir pessoa e registros</button>
          </div>); })}
      </div>
    </section>
  );
}

