const NOTAS_USADAS = {};
function gerarNotas(seg, obj, tom, produto, cliente, qtd) {
  const sg = CSEG[seg]; const oi = COBJ.indexOf(obj);
  const pr = cortar((produto || "").trim() || "o nosso serviço", 26);
  const base = [...NOTAS_TOM[tom], ...NOTAS_OBJ[oi]];
  const seeds = sg.balao.map(b => b + ". Toque aqui e me chama no Direct");
  const todas = [...base, ...seeds];
  let lista = [];
  sg.desejos.forEach(r => todas.forEach(t => { if (t.includes("{res}")) lista.push(limpar(subst(t, { prod: pr, res: r }))); }));
  todas.forEach(t => { if (!t.includes("{res}")) lista.push(limpar(subst(t, { prod: pr, res: "" }))); });
  const heads = [...NOTAS_HEAD_TOM[tom], ...sg.balao];
  heads.forEach(h => { const hs = h.includes("{res}") ? sg.desejos.map(r => subst(h, { prod: pr, res: r })) : [subst(h, { prod: pr, res: "" })]; hs.forEach(x => NOTAS_TAILS.forEach(t => lista.push(limpar(x + (/[?!.]$/.test(x) ? " " : ". ") + t)))); });
  lista = Array.from(new Set(lista)).filter(t => t.length >= 45 && t.length <= 80);
  if (lista.length === 0) lista = [limpar(cortar("Toque aqui e fale comigo no Direct sobre " + pr, 80))];
