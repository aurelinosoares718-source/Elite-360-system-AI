            <div key={x.id} className="rounded-xl border border-[#27272a] bg-[#09090b] p-3 grid gap-2 grid-cols-2">
              <input className={field + " col-span-2"} placeholder="Nome do serviço" value={x.nome} onChange={e => setSv(x.id, "nome", e.target.value)} />
              <input className={field} inputMode="decimal" placeholder="Preço (R$)" value={x.preco} onChange={e => setSv(x.id, "preco", e.target.value)} />
              <input className={field} inputMode="decimal" placeholder="Margem (%)" value={x.margem} onChange={e => setSv(x.id, "margem", e.target.value)} />
              <p className="text-xs text-gray-400 self-center">Lucro por venda: <b style={{ color: NEON }}>{brl(lu)}</b></p>
              <button onClick={() => setDr({ ...dr, servicos: dr.servicos.filter(y => y.id !== x.id) })} className="justify-self-end text-xs text-gray-500 hover:text-red-400">Remover</button>
            </div>); })}
          <button onClick={() => setDr({ ...dr, servicos: [...dr.servicos, { id: "s" + Date.now(), nome: "", preco: "", margem: "" }] })} className="rounded-xl border border-dashed border-[#D4AF37]/50 py-2.5 text-sm text-[#D4AF37]">+ Adicionar serviço</button>
        </div>)}

      {sec("expediente", "Horário de Expediente",
        <div className="grid gap-1">{linha("Dias", perfil.expediente.dias.map(i => DIAS[i]).join(", "))}{linha("Turno", perfil.expediente.ini + " às " + perfil.expediente.fim)}<p className="text-xs text-gray-600 mt-1">Alertas de follow-up e metas só aparecem dentro desse horário.</p></div>, salvarExp,
