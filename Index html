function tocarCaixa() {
  try {
    const AC = window.AudioContext || window.webkitAudioContext;
    if (AC) {
      const c = new AC(); const t = c.currentTime;
      if (c.state === "suspended") c.resume();
      const master = c.createGain(); master.gain.value = 1.0;
      const comp = c.createDynamicsCompressor();
      comp.threshold.value = -18; comp.knee.value = 12; comp.ratio.value = 6; comp.attack.value = 0.003; comp.release.value = 0.2;
      master.connect(comp); comp.connect(c.destination);
      const ruido = (dur) => { const n = Math.floor(c.sampleRate * dur); const b = c.createBuffer(1, n, c.sampleRate); const x = b.getChannelData(0); for (let i = 0; i < n; i++) x[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / n, 2); return b; };
      const rajada = (at, dur, tipo, freq, q, ganho) => { const sr = c.createBufferSource(); sr.buffer = ruido(dur); const f = c.createBiquadFilter(); f.type = tipo; f.frequency.value = freq; f.Q.value = q; const g = c.createGain(); g.gain.value = ganho; sr.connect(f); f.connect(g); g.connect(master); sr.start(t + at); };
      const tom = (at, freq, dur, ganho, tipo) => { const o = c.createOscillator(), g = c.createGain(); o.type = tipo || "sine"; o.frequency.setValueAtTime(freq, t + at); g.gain.setValueAtTime(0.0001, t + at); g.gain.exponentialRampToValueAtTime(ganho, t + at + 0.004); g.gain.exponentialRampToValueAtTime(0.0001, t + at + dur); o.connect(g); g.connect(master); o.start(t + at); o.stop(t + at + dur + 0.05); };
      rajada(0, 0.07, "bandpass", 1800, 1.2, 1.0);
      tom(0, 160, 0.16, 1.0, "sine");
      rajada(0.07, 0.28, "bandpass", 900, 0.8, 0.6);
      tom(0.08, 90, 0.2, 0.8, "sine");
      [0.28, 0.33, 0.37, 0.42, 0.46, 0.5, 0.55].forEach((at, i) => { const f = 3000 + ((i * 631) % 2200); tom(at, f, 0.14, 0.45, "square"); tom(at, f * 1.51, 0.1, 0.3, "sine"); });
      tom(0.2, 2093, 1.2, 0.7, "sine"); tom(0.2, 3136, 0.9, 0.45, "sine"); tom(0.2, 4186, 0.6, 0.25, "sine");
      setTimeout(() => { try { c.close(); } catch (e) {} }, 2200);
    }
  } catch (e) {}
}

// Som de venda: toca o elemento <audio id="som-venda"> (tlim). Se o navegador bloquear, usa o som sintetizado.
function celebrar(som) {
  if (som === false) return;
  let ok = false;
  try {
    const a = document.getElementById("som-venda");
    if (a) { a.pause(); a.currentTime = 0; a.volume = 1; const pr = a.play(); if (pr && pr.catch) pr.catch(() => tocarCaixa()); ok = true; }
  } catch (e) {}
  if (!ok) tocarCaixa();
}

