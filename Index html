      {typeof window !== "undefined" && window.__eliteSW && <button onClick={() => { try { window.__eliteSW.update(); } catch (e) {} setErr("Verificação enviada. Se houver versão nova, o aviso aparece no topo."); }} className="mt-3 block text-xs text-[#D4AF37] underline">Verificar atualização do app</button>}
      {err && ed === null && <p className="mt-2 text-xs text-gray-400">{err}</p>}
    </Modal>
  );
}

function Notas({ notas, setNotas }) {
  const [titulo, setTitulo] = useState("");
  const [texto, setTexto] = useState("");
  const [edit, setEdit] = useState(null);
  const [conf, setConf] = useState(null);
  const add = () => { if (!texto.trim() && !titulo.trim()) return; setNotas([...notas, { id: Date.now(), titulo: titulo.trim(), texto: texto.trim(), criado: new Date().toISOString(), editado: "" }]); setTitulo(""); setTexto(""); };
  const salvar = () => { if (!edit.texto.trim() && !edit.titulo.trim()) return; setNotas(notas.map(n => n.id === edit.id ? { ...n, titulo: edit.titulo.trim(), texto: edit.texto.trim(), editado: new Date().toISOString() } : n)); setEdit(null); };
  const lista = [...notas].sort((a, b) => (b.editado || b.criado).localeCompare(a.editado || a.criado));
  const fm = (iso) => { const d = new Date(iso); return d.toLocaleDateString("pt-BR") + " " + d.toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" }); };
  return (
    <section>
      <h2 className="text-lg sm:text-xl font-extrabold text-[#D4AF37]">Bloco de Notas</h2>
      <p className="text-xs text-gray-500 mb-4">Anotações livres. Ficam salvas na sua conta, neste aparelho.</p>
      <div className="rounded-2xl border border-[#27272a] bg-[#18181b] p-4 grid gap-3">
        <input className={field} placeholder="Título (opcional)" value={titulo} onChange={e => setTitulo(e.target.value)} />
        <textarea rows={3} className={field} placeholder="Escreva sua anotação..." value={texto} onChange={e => setTexto(e.target.value)} />
        <button onClick={add} className="justify-self-start rounded-xl px-5 py-2.5 text-sm font-extrabold text-black" style={{ background: NEON }}>Adicionar Nota</button>
      </div>
      <div className="mt-4 grid gap-3 lg:grid-cols-2">
        {lista.length === 0 && <p className="text-sm text-gray-500">Nenhuma nota ainda.</p>}
        {lista.map(n => (
          <div key={n.id} className="min-w-0 rounded-2xl border border-[#27272a] bg-[#18181b] p-4">
            {edit && edit.id === n.id ? (
              <div className="grid gap-2">
                <input className={field} value={edit.titulo} onChange={e => setEdit({ ...edit, titulo: e.target.value })} placeholder="Título" />
                <textarea rows={4} className={field} value={edit.texto} onChange={e => setEdit({ ...edit, texto: e.target.value })} />
                <div className="flex gap-2"><button onClick={salvar} className="rounded-lg px-4 py-2 text-xs font-bold text-black" style={{ background: NEON }}>Salvar</button><button onClick={() => setEdit(null)} className="rounded-lg border border-[#27272a] px-4 py-2 text-xs text-gray-300">Cancelar</button></div>
              </div>
            ) : (<>
              {n.titulo && <p className="font-semibold text-gray-100">{n.titulo}</p>}
              {n.texto && <p className="mt-1 whitespace-pre-line text-sm text-gray-300">{n.texto}</p>}
              <p className="mt-2 text-[11px] text-gray-600">{n.editado ? "Editada em " + fm(n.editado) : "Criada em " + fm(n.criado)}</p>
              <div className="mt-3 flex flex-wrap gap-2">
                <button onClick={() => { setEdit({ id: n.id, titulo: n.titulo, texto: n.texto }); setConf(null); }} className="rounded-lg border border-[#D4AF37]/50 px-3 py-1.5 text-xs text-[#D4AF37]">Editar</button>
                {conf === n.id
                  ? <><button onClick={() => { setNotas(notas.filter(x => x.id !== n.id)); setConf(null); }} className="rounded-lg bg-red-500 px-3 py-1.5 text-xs font-bold text-black">Confirmar exclusão</button><button onClick={() => setConf(null)} className="rounded-lg border border-[#27272a] px-3 py-1.5 text-xs text-gray-300">Cancelar</button></>
                  : <button onClick={() => setConf(n.id)} className="rounded-lg border border-[#27272a] px-3 py-1.5 text-xs text-gray-400 hover:text-red-400">Excluir</button>}
              </div>
            </>)}
          </div>
        ))}
      </div>
    </section>
  );
}

