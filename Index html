          <div className="mt-3 grid gap-2 sm:grid-cols-2">
            <select className={field} value={r.membro} onChange={e => setR({ ...r, membro: e.target.value })}>{time.membros.length === 0 && <option value="">Cadastre uma pessoa</option>}{time.membros.map(x => <option key={x.id} value={x.id}>{x.nome}</option>)}</select>
            <input className={field} type="date" value={r.data} onChange={e => setR({ ...r, data: e.target.value })} />
            <input className={field} type="number" min="0" inputMode="numeric" placeholder="Atendimentos" value={r.atend} onChange={e => setR({ ...r, atend: e.target.value })} />
