const esperaGesto = (c, tocar) => { const f = () => { window.removeEventListener("pointerdown", f); window.removeEventListener("keydown", f); c.resume().then(tocar).catch(() => {}); }; window.addEventListener("pointerdown", f); window.addEventListener("keydown", f); };
function tocarPim() {
  try {
    const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
    const c = new AC();
    const tocar = () => {
      const t = c.currentTime;
      [[1318.5, 0], [1760, 0.13]].forEach(([f, a]) => { const o = c.createOscillator(), g = c.createGain(); o.type = "sine"; o.frequency.value = f; g.gain.setValueAtTime(0.0001, t + a); g.gain.exponentialRampToValueAtTime(0.22, t + a + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, t + a + 0.35); o.connect(g); g.connect(c.destination); o.start(t + a); o.stop(t + a + 0.4); });
      setTimeout(() => { try { c.close(); } catch (e) {} }, 900);
    };
    if (c.state === "running") tocar();
    else c.resume().then(() => { if (c.state === "running") tocar(); else esperaGesto(c, tocar); }).catch(() => esperaGesto(c, tocar));
  } catch (e) {}
}

