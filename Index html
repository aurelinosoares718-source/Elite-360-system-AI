              <button onClick={() => entrada(i.id)} className="rounded-lg border border-[#27272a] px-3 py-1.5 text-xs text-gray-300">Registrar entrada</button>
              <button onClick={() => { if (confirmaExcluir()) upd(a => a.filter(x => x.id !== i.id)); }} className="rounded-lg border border-[#27272a] px-3 py-1.5 text-xs text-gray-500 hover:text-red-400">Excluir</button>
            </div>
          </div>))}
      </div>
    </section>
  );
}

