  medo: { nome: "Medo ou insegurança com o resultado", re: /medo|receio|inseguran|funciona mesmo|garantia|ser[aá] que|e se n[aã]o|d[oó]i/ },
  tempo: { nome: "Falta de tempo ou timing", re: /sem tempo|corrido|agenda cheia|n[aã]o tenho tempo|semana que vem|m[eê]s que vem|mais pra frente|mais para frente|agora n[aã]o|outro momento/ },
  pensar: { nome: "Vou pensar", re: /vou pensar|preciso pensar|deixa eu pensar|vou ver|depois eu (falo|vejo|te aviso)|te aviso|deixa eu ver|n[aã]o sei ainda|preciso refletir/ },
  terceiro: { nome: "Decisão compartilhada", re: /marido|espos|namorad|companheir|s[oó]cio|chefe|diretoria|conversar com|falar com (o|a|meu|minha)|ver com (o|a)/ },
};
const OBJ_ORDEM = ["preco", "pagamento", "concorrente", "confianca", "medo", "tempo", "pensar", "terceiro"];
const SESSAO_ART = { saude: "uma sessão", imob: "uma visita", info: "uma call", servicos: "uma reunião", produto: "um pedido", outros: "um horário" };
function detectarObjecao(txt) {
  const t = (txt || "").toLowerCase();
  const k = OBJ_ORDEM.find(x => OBJ[x].re.test(t));
  if (!k) return null;
  const m = t.match(OBJ[k].re);
  const i = t.search(/[.!?\n]/g);
  const ini = Math.max(0, t.lastIndexOf("\n", m.index), Math.max(t.lastIndexOf(".", m.index), t.lastIndexOf("!", m.index), t.lastIndexOf("?", m.index)) + 1);
  const fimC = t.slice(m.index).search(/[.!?\n]/);
  const fim = fimC === -1 ? t.length : m.index + fimC + 1;
  const trecho = (txt || "").slice(ini, fim).trim().slice(0, 140);
  return { k, nome: OBJ[k].nome, trecho, terceiro: k !== "terceiro" && OBJ.terceiro.re.test(t) };
}
function saudacao(tom, nm) {
