          <div key={x.mb.id} className="min-w-0 rounded-2xl border border-[#27272a] bg-[#18181b] p-4">
            <div className="flex items-start justify-between gap-2"><div className="min-w-0"><p className="break-words font-bold text-gray-100">{["🥇", "🥈", "🥉"][i] || (i + 1) + "º"} {x.mb.nome}</p><p className="text-[11px] text-gray-500">{x.mb.funcao || "Equipe"}</p></div><span className="shrink-0 rounded-full border border-[#D4AF37]/50 px-2.5 py-1 text-[11px] text-[#EAB308]">{x.pontos} pts</span></div>
