    if (tipo === "sino") { tom(0, 880, 1.0, 0.7); tom(0, 1320, 0.8, 0.4); tom(0.35, 1175, 1.0, 0.6); tom(0.35, 1760, 0.8, 0.3); }
    else if (tipo === "alerta") { [0, 0.25, 0.5].forEach(a => tom(a, 1000, 0.18, 0.5, "square")); }
    else if (tipo === "gota") { tom(0, 900, 0.35, 0.8, "sine", 350); tom(0.4, 700, 0.35, 0.6, "sine", 280); }
