const somaDias = (iso, n) => { const [y, m, d] = iso.split("-").map(Number); const x = new Date(y, m - 1, d + n); return x.getFullYear() + "-" + String(x.getMonth() + 1).padStart(2, "0") + "-" + String(x.getDate()).padStart(2, "0"); };
const zapDe = (c) => { const dg = String(c || "").replace(/\D/g, ""); return dg.length >= 10 ? "https://wa.me/" + (dg.length <= 11 ? "55" + dg : dg) : ""; };
const kpi = (t, v, sub, cor) => (<div className="min-w-0 rounded-xl border border-[#27272a] bg-[#09090b] p-3"><p className="text-[10px] uppercase tracking-wider text-gray-500">{t}</p><p className="mt-1 text-lg font-extrabold break-words" style={{ color: cor || "#fff" }}>{v}</p>{sub && <p className="text-[10px] text-gray-500 break-words">{sub}</p>}</div>);
