  const upd = (fn) => setD(x => ({ ...x, time: fn(x.time) }));
  const mes = hojeISO().slice(0, 7);
  const addM = () => { if (!m.nome.trim()) return; upd(t => ({ ...t, membros: [...t.membros, { id: Date.now(), nome: m.nome.trim().slice(0, 60), funcao: m.funcao.trim().slice(0, 60), meta: Math.max(0, Number(m.meta) || 0) }] })); setM({ nome: "", funcao: "", meta: "" }); };
  const addR = () => { const id = Number(r.membro || (time.membros[0] || {}).id); if (!id) return; const at = Math.max(0, Math.floor(Number(r.atend) || 0)), fe = Math.max(0, Math.floor(Number(r.fech) || 0)), va = Math.max(0, Number(r.valor) || 0); if (!at && !fe && !va) return; upd(t => ({ ...t, reg: [...t.reg, { id: Date.now(), membro: id, data: r.data || hojeISO(), atend: at, fech: fe, valor: va }].slice(-2000) })); setR({ ...r, atend: "", fech: "", valor: "" }); };
  const rank = time.membros.map(mb => { const rg = time.reg.filter(x => x.membro === mb.id && x.data.slice(0, 7) === mes); const atend = rg.reduce((x, y) => x + y.atend, 0), fech = rg.reduce((x, y) => x + y.fech, 0), valor = rg.reduce((x, y) => x + y.valor, 0); return { mb, atend, fech, valor, conv: atend ? fech / atend * 100 : 0, ticket: fech ? valor / fech : 0, pontos: atend + fech * 10 }; }).sort((a, b) => b.valor - a.valor || b.fech - a.fech);
  const tot = rank.reduce((x, y) => ({ atend: x.atend + y.atend, fech: x.fech + y.fech, valor: x.valor + y.valor }), { atend: 0, fech: 0, valor: 0 });
