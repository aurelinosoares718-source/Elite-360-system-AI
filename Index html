function Estoque({ itens, setD }) {
  const [f, setF] = useState({ nome: "", qtd: "", min: "", lead: "7" });
  const [q, setQ] = useState({});
  const upd = (fn) => setD(x => ({ ...x, estoque: fn(x.estoque) }));
  const add = () => { const nome = f.nome.trim(); if (!nome) return; upd(a => [...a, { id: Date.now(), nome: nome.slice(0, 60), qtd: Math.max(0, Number(f.qtd) || 0), min: Math.max(0, Number(f.min) || 0), lead: Math.max(1, Number(f.lead) || 7), mov: [] }]); setF({ nome: "", qtd: "", min: "", lead: f.lead }); };
  const qn = (id) => Math.floor(Number(q[id]) || 0);
  const saida = (id) => { const n = qn(id); if (n <= 0) return; upd(a => a.map(i => i.id === id ? { ...i, qtd: Math.max(0, i.qtd - n), mov: [...i.mov, { d: hojeISO(), q: n }].slice(-200) } : i)); setQ({ ...q, [id]: "" }); };
  const entrada = (id) => { const n = qn(id); if (n <= 0) return; upd(a => a.map(i => i.id === id ? { ...i, qtd: i.qtd + n } : i)); setQ({ ...q, [id]: "" }); };
  const prever = (i) => { const mv = i.mov.filter(m => diasDesde(m.d) <= 30); if (!mv.length) return null; const janela = Math.min(30, Math.max(7, Math.max(...mv.map(m => diasDesde(m.d))) + 1)); const cons = mv.reduce((x, m) => x + m.q, 0) / janela; return { cons, dias: cons > 0 ? i.qtd / cons : null, repor: Math.max(0, Math.ceil(cons * (i.lead + 15) - i.qtd)) }; };
  const stat = (i) => { const p = prever(i); if (i.qtd <= 0) return { ord: 0, nome: "Sem estoque", cor: "#f87171", p }; if (i.qtd <= i.min || (p && p.dias !== null && p.dias <= i.lead)) return { ord: 1, nome: "Reposição urgente", cor: "#f87171", p }; if (p && p.dias !== null && p.dias <= i.lead + 7) return { ord: 2, nome: "Atenção", cor: "#EAB308", p }; return { ord: 3, nome: p ? "Saudável" : "Sem histórico", cor: p ? NEON : "#9ca3af", p }; };
  const lista = itens.map(i => ({ i, st: stat(i) })).sort((a, b) => a.st.ord - b.st.ord);
  const risco = lista.filter(x => x.st.ord <= 1).length;
  return (
    <section>
      <h2 className="text-lg sm:text-xl font-extrabold text-[#D4AF37]">Inteligência Preditiva de Estoque</h2>
      <p className="text-xs text-gray-500 mb-4">Registre as saídas no dia a dia. O sistema calcula o consumo médio dos últimos 30 dias, prevê a ruptura e sugere quanto repor.</p>
      <div className="grid grid-cols-2 gap-2 sm:grid-cols-3">{kpi("Produtos", itens.length)}{kpi("Em risco", risco, "reposição urgente ou sem estoque", risco ? "#f87171" : NEON)}{kpi("Unidades em estoque", itens.reduce((x, i) => x + i.qtd, 0))}</div>
      <div className="mt-4 rounded-2xl border border-[#27272a] bg-[#18181b] p-4">
        <p className="text-sm font-bold text-gray-100">Cadastrar produto</p>
        <div className="mt-3 grid gap-2 sm:grid-cols-5">
          <input className={field + " sm:col-span-2"} placeholder="Nome do produto" maxLength={60} value={f.nome} onChange={e => setF({ ...f, nome: e.target.value })} />
          <input className={field} type="number" min="0" inputMode="numeric" placeholder="Qtd. atual" value={f.qtd} onChange={e => setF({ ...f, qtd: e.target.value })} />
          <input className={field} type="number" min="0" inputMode="numeric" placeholder="Estoque mínimo" value={f.min} onChange={e => setF({ ...f, min: e.target.value })} />
          <input className={field} type="number" min="1" inputMode="numeric" placeholder="Prazo de reposição (dias)" value={f.lead} onChange={e => setF({ ...f, lead: e.target.value })} />
        </div>
        <button onClick={add} className="mt-3 rounded-xl bg-gradient-to-r from-[#D4AF37] to-[#EAB308] px-5 py-2.5 text-xs font-extrabold text-black">Adicionar produto</button>
      </div>
      <div className="mt-4 grid gap-3 lg:grid-cols-2">
        {lista.length === 0 && <p className="text-sm text-gray-500">Nenhum produto cadastrado ainda.</p>}
        {lista.map(({ i, st }) => (
          <div key={i.id} className="min-w-0 rounded-2xl border border-[#27272a] bg-[#18181b] p-4">
            <div className="flex items-start justify-between gap-2"><p className="min-w-0 break-words font-bold text-gray-100">{i.nome}</p><span className="shrink-0 rounded-full border px-2.5 py-1 text-[11px]" style={{ borderColor: st.cor, color: st.cor }}>{st.nome}</span></div>
            <p className="mt-2 text-sm text-gray-300">Em estoque: <b>{i.qtd}</b> · Mínimo: {i.min} · Reposição em {i.lead} dias</p>
            <p className="mt-1 text-xs text-gray-400 break-words">{st.p ? "Consumo médio: " + st.p.cons.toFixed(1).replace(".", ",") + " por dia" + (st.p.dias !== null ? " · Ruptura prevista em cerca de " + Math.floor(st.p.dias) + " dias" : "") + " · Sugestão de reposição: " + st.p.repor + " un." : "Registre saídas para liberar a previsão."}</p>
