function leituraCliente(c) {
  const t = (c || "").toLowerCase();
  const has = (re) => re.test(t);
  let tom = "próximo, claro e direto";
  if (has(/premium|luxo|alto padr|exclusiv|sofistic/)) tom = "elegante e seguro, sem apelo de preço, com foco em exclusividade e cuidado";
  else if (has(/econ[oô]mic|barato|custo|popular|desconto/)) tom = "prático e transparente, com foco em custo-benefício e facilidade de pagamento";
  else if (has(/empres[aá]ri|empreendedor|dono|gestor|ceo|profissional liberal/)) tom = "objetivo, com foco em tempo, retorno e resultado";
  else if (has(/m[aã]e|m[aã]es|rotina corrida/)) tom = "acolhedor e rápido, pensando em quem tem pouco tempo";
  const m = t.match(/(\d{2})\s*(?:a|-|até|ate)\s*(\d{2})/);
  let formato = "mantenha o formato do dia e ajuste o ritmo ao seu público";
  if (has(/jovem|jovens|gen z|universit/) || (m && +m[2] <= 30)) formato = "priorize Reels curtos (até 20 segundos), com cortes rápidos";
  else if (m && +m[1] >= 45) formato = "Carrossel e Stories com letra grande e ritmo calmo funcionam bem";
