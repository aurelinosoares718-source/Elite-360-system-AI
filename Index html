  const margemV = fm.reduce((x, v) => x + (v.lucro || 0), 0);
  const eq = perfil.equipe || {};
  const desp = perfil.despesas || 0, folha = eq.tem ? (eq.folha || 0) : 0;
  const lucro = margemV - desp - folha;
  const meta = perfil.meta || 0;
  const pct = meta > 0 ? Math.min(100, (fat / meta) * 100) : 0;
  const pg = PAGTOS.map(p => [p, soma(fm.filter(v => v.pagamento === p))]).filter(x => x[1] > 0);
  const quentes = leads.filter(l => !l.convertido && diasDesde(l.data) >= 1 && diasDesde(l.data) <= 3).length;
  const exp = dentroExpediente(perfil);
  const nome = [perfil.trat, perfil.nome].filter(Boolean).join(" ");
  const card = (t, v, c) => (<div className="min-w-0 rounded-2xl border border-[#27272a] bg-[#18181b] p-4"><p className="text-[11px] uppercase tracking-wider text-gray-400">{t}</p><p className="mt-1 text-lg sm:text-xl font-extrabold break-words" style={{ color: c || "#fff" }}>{v}</p></div>);
  const alerta = quentes > 0 && exp && <p className="mt-3 rounded-xl border border-[#D4AF37]/40 bg-[#D4AF37]/10 p-3 text-sm text-[#EAB308]">🔥 {quentes} {quentes === 1 ? "lead quente espera" : "leads quentes esperam"} follow-up hoje. Abra a aba CRM de Leads.</p>;
  return (
    <section className="mb-6" {...(!rec ? { "data-guia-nome": "Cockpit Financeiro", "data-guia-chave": "financeiro" } : {})}>
      <div className="flex flex-wrap items-center gap-2 mb-3">
        <h2 className="text-base sm:text-lg font-extrabold text-white mr-auto">{nome ? "Olá, " + nome : "Cockpit Financeiro"}{perfil.empresa ? <span className="text-gray-500 font-medium"> · {perfil.empresa}</span> : null}</h2>
        <span className={"rounded-full border px-2.5 py-1 text-[11px] " + (exp ? "border-[#39FF14]/50 text-[#39FF14]" : "border-[#27272a] text-gray-500")}>{exp ? "Dentro do expediente" : "Fora do expediente"}</span>
        <span className="rounded-full border border-[#27272a] px-2.5 py-1 text-[11px] text-gray-300">{rot.sessoes} hoje: <b style={{ color: NEON }}>{agHoje || 0}</b></span>
        {!rec && onNicho && <button onClick={onNicho} className="rounded-xl border border-[#D4AF37]/60 px-3 py-2 text-xs font-bold text-[#D4AF37]">✎ Editar Nicho</button>}
        {!rec && <button onClick={onRel} className="rounded-xl border border-[#39FF14]/60 px-3 py-2 text-xs font-bold" style={{ color: NEON }}>Relatório Mensal</button>}
        <button onClick={onVenda} className="rounded-xl px-4 py-2 text-xs font-extrabold text-black" style={{ background: NEON }}>+ Registrar Venda</button>
      </div>
      {rec ? (<>
        <p className="rounded-xl border border-[#27272a] bg-[#18181b] p-3 text-xs text-gray-400">Modo protegido ativo: lance vendas e atenda clientes. Faturamento, lucro, custos e relatórios ficam protegidos pela governança.</p>
        {alerta}
      </>) : (<>
        <BriefingDia perfil={perfil} vendas={vendas} leads={leads} agHoje={agHoje} />
        <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
          {card("Meta do Mês", meta > 0 ? brl(meta) : "Não definida", NEON)}
          {card("Faturamento do Mês", brl(fat))}
          {card("Faturado Hoje", brl(fatHoje))}
          {card("Lucro Operacional Real", brl(lucro), lucro < 0 ? "#f87171" : NEON)}
        </div>
        <div className="mt-3 rounded-2xl border border-[#27272a] bg-[#18181b] p-4">
          <div className="flex items-center justify-between text-xs text-gray-400 mb-2"><span>Progresso da meta</span><span style={{ color: NEON }} className="font-bold">{meta > 0 ? pct.toFixed(0) + "%" : "defina sua meta"}</span></div>
          <div className="h-3 w-full overflow-hidden rounded-full bg-[#27272a]"><div className="h-full rounded-full transition-all duration-700" style={{ width: pct + "%", background: NEON, boxShadow: "0 0 10px " + NEON + "99" }} /></div>
          {meta <= 0 && <button onClick={onPerfil} className="mt-3 text-xs text-[#D4AF37] underline">Definir meta e perfil</button>}
          <p className="mt-3 text-xs text-gray-400 break-words">Margem das vendas {brl(margemV)} menos despesas fixas {brl(desp)} menos folha {brl(folha)} igual a lucro operacional real de {brl(lucro)}.</p>
          {pg.length > 0 && <p className="mt-2 text-xs text-gray-500 break-words">Por forma de pagamento: {pg.map(x => x[0] + " " + brl(x[1])).join(" · ")}</p>}
          <p className="mt-2 text-[11px] text-gray-600">O faturamento reinicia sozinho na virada do mês; a meta e os custos ficam salvos. O lucro usa a margem do serviço escolhido no registro.</p>
        </div>
        <button onClick={onAud} className="mt-3 w-full rounded-xl border border-[#22d3ee]/40 bg-[#22d3ee]/5 py-3 text-sm font-bold text-[#EAB308] hover:bg-[#22d3ee]/10">📥 Baixar Relatório Executivo Completo para Análise da Elite</button>
        {alerta}
      </>)}
    </section>
  );
}

function VendaModal({ perfil, onSave, onClose, rec }) {
  const rot = useRot();
  const [f, setF] = useState({ nome: "", serv: "", valor: "", origem: ORIGENS[0], pag: PAGTOS[0], data: "" });
  const [nv, setNv] = useState({ nome: "", preco: "", margem: "" });
  const [err, setErr] = useState("");
  const up = (k) => (e) => setF({ ...f, [k]: e.target.value });
  const novo = f.serv === "__novo";
  const svc = perfil.servicos.find(x => x.id === f.serv);
  const escolher = (e) => { const id = e.target.value; const sv = perfil.servicos.find(x => x.id === id); setF({ ...f, serv: id, valor: sv && sv.preco ? String(sv.preco).replace(".", ",") : f.valor }); };
  const salvar = () => {
    const v = parseValor(f.valor);
    if (!f.nome.trim()) { setErr("Informe o nome do cliente."); return; }
    if (v <= 0) { setErr("Informe o valor da venda."); return; }
    let sv = svc, novoSv = null;
    if (novo) {
      if (!nv.nome.trim()) { setErr("Informe o nome do novo serviço."); return; }
      novoSv = { id: "s" + Date.now(), nome: nv.nome.trim(), preco: parseValor(nv.preco) || v, margem: Math.max(0, Math.min(100, parseValor(nv.margem))) };
      sv = novoSv;
    }
    const margem = sv ? Number(sv.margem) || 0 : null;
    onSave({ id: Date.now(), data: f.data || hojeISO(), nome: f.nome.trim(), valor: v, status: "Fechada", servico: sv ? sv.nome : (f.serv === "outro" ? "Outro" : ""), origem: f.origem, pagamento: f.pag, lucro: margem === null ? 0 : Math.round(v * margem) / 100 }, novoSv);
  };
  const lucroPrev = (svc ? Number(svc.margem) || 0 : novo ? Math.max(0, Math.min(100, parseValor(nv.margem))) : null);
  return (
    <Modal onClose={onClose}>
      <p className="text-sm font-bold" style={{ color: NEON }}>Registrar Venda</p>
      <div className="mt-4 grid gap-3">
        <input className={field} placeholder={"Nome do " + rot.cliente.toLowerCase()} value={f.nome} onChange={up("nome")} />
        <select className={field} value={f.serv} onChange={escolher}>
          <option value="">{rot.servico} (opcional)</option>
          {perfil.servicos.map(x => <option key={x.id} value={x.id}>{(x.nome || "Serviço sem nome") + " · " + brl(parseValor(x.preco)) + (rec ? "" : " · margem " + (Number(x.margem) || 0) + "%")}</option>)}
          {!rec && <option value="__novo">+ Cadastrar novo serviço</option>}
          <option value="outro">Outro (sem margem)</option>
        </select>
        {novo && <div className="rounded-xl border border-[#D4AF37]/40 p-3 grid grid-cols-2 gap-2">
          <input className={field + " col-span-2"} placeholder="Nome do novo serviço" value={nv.nome} onChange={e => setNv({ ...nv, nome: e.target.value })} />
          <input className={field} inputMode="decimal" placeholder="Preço base (R$)" value={nv.preco} onChange={e => setNv({ ...nv, preco: e.target.value })} />
          <input className={field} inputMode="decimal" placeholder="Margem (%)" value={nv.margem} onChange={e => setNv({ ...nv, margem: e.target.value })} />
          <p className="col-span-2 text-[11px] text-gray-500">Este serviço será salvo no seu perfil para as próximas vendas.</p>
        </div>}
        <input className={field} inputMode="decimal" placeholder="Valor da venda (R$)" value={f.valor} onChange={up("valor")} />
        {!rec && lucroPrev !== null && parseValor(f.valor) > 0 && <p className="text-xs text-gray-400">Lucro desta venda: <b style={{ color: NEON }}>{brl(parseValor(f.valor) * lucroPrev / 100)}</b></p>}
        <select className={field} value={f.origem} onChange={up("origem")}>{ORIGENS.map(o => <option key={o}>{o}</option>)}</select>
        <select className={field} value={f.pag} onChange={up("pag")}>{PAGTOS.map(o => <option key={o}>{o}</option>)}</select>
        <input type="date" className={field + " block w-full max-w-full min-w-0"} value={f.data || hojeISO()} onChange={up("data")} />
      </div>
      {perfil.servicos.length === 0 && !novo && <p className="mt-2 text-xs text-gray-500">Você ainda não cadastrou serviços. Use "Cadastrar novo serviço" ou o Perfil.</p>}
      {err && <p className="mt-2 text-xs text-red-400">{err}</p>}
      <div className="mt-4 flex gap-2">
        <button onClick={onClose} className="flex-1 rounded-xl border border-[#27272a] py-2.5 text-sm text-gray-300">Cancelar</button>
        <button onClick={salvar} className="flex-1 rounded-xl py-2.5 text-sm font-extrabold text-black" style={{ background: NEON }}>Registrar</button>
      </div>
    </Modal>
  );
}

function Secao({ titulo, editando, onEdit, onSave, onCancel, view, children }) {
  return (
    <div className="mt-4 rounded-xl border border-[#27272a] bg-[#18181b] p-4">
      <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
        <p className="text-xs font-semibold uppercase tracking-wider text-[#D4AF37]">{titulo}</p>
        {editando
          ? <div className="flex gap-2"><button onClick={onCancel} className="rounded-lg border border-[#27272a] px-3 py-1.5 text-xs text-gray-300">Cancelar</button><button onClick={onSave} className="rounded-lg px-3 py-1.5 text-xs font-bold text-black" style={{ background: NEON }}>Salvar</button></div>
          : <button onClick={onEdit} className="rounded-lg border border-[#D4AF37]/50 px-3 py-1.5 text-xs text-[#D4AF37]">Editar / Ajustar</button>}
      </div>
      {editando ? children : view}
    </div>
  );
}
const linha = (k, v) => (<p className="text-sm text-gray-300 break-words"><span className="text-gray-500">{k}: </span>{v || <span className="text-gray-600">não informado</span>}</p>);
const txtNum = (n) => (n ? String(n).replace(".", ",") : "");

