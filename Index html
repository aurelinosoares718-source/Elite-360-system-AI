    setErr("");
    setDr({ nome: perfil.nome, trat: perfil.trat, empresa: perfil.empresa, nicho: perfil.nicho, tipo: perfil.nichoTipo, destrava: false, cliente: perfil.cliente || "",
      servicos: perfil.servicos.map(x => ({ ...x, preco: txtNum(x.preco), margem: txtNum(x.margem) })),
      expediente: { ...perfil.expediente, dias: [...perfil.expediente.dias] },
