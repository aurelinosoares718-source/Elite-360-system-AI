        <div className="grid gap-1">{linha("Meta do mês", perfil.meta ? brl(perfil.meta) : "")}{linha("Despesas fixas mensais", perfil.despesas ? brl(perfil.despesas) : "")}{linha("Equipe", eq.tem ? (eq.qtd || 0) + " pessoa(s), folha total de " + brl(eq.folha || 0) : "Não possui funcionários")}</div>, salvarFin,
