  const salvarNicho = () => { if (!dr.tipo || dr.nicho.trim().length < 3) { setErr("Escolha ou digite seu nicho."); return; } gravar({ nicho: dr.nicho.trim(), nichoTipo: dr.tipo, cliente: dr.cliente.trim() }); };
