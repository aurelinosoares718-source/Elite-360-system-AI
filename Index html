      <div className="mt-4 grid gap-3 lg:grid-cols-2">
        <div className="rounded-2xl border border-[#27272a] bg-[#18181b] p-4">
          <p className="text-sm font-bold text-gray-100">Cadastrar pessoa</p>
          <div className="mt-3 grid gap-2 sm:grid-cols-3"><input className={field} placeholder="Nome" maxLength={60} value={m.nome} onChange={e => setM({ ...m, nome: e.target.value })} /><input className={field} placeholder="Função" maxLength={60} value={m.funcao} onChange={e => setM({ ...m, funcao: e.target.value })} /><input className={field} type="number" min="0" inputMode="decimal" placeholder="Meta mensal (R$)" value={m.meta} onChange={e => setM({ ...m, meta: e.target.value })} /></div>
          <button onClick={addM} className="mt-3 rounded-xl bg-gradient-to-r from-[#D4AF37] to-[#EAB308] px-5 py-2.5 text-xs font-extrabold text-black">Adicionar pessoa</button>
        </div>
