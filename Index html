function calcAlertas(d) {
  const out = []; const hoje = hojeISO(); const ag = new Date(); const min = ag.getHours() * 60 + ag.getMinutes();
  d.agenda.forEach(a => {
    if (a.status !== "Agendado" || a.data !== hoje) return;
    const diff = parseInt(a.hora.slice(0, 2), 10) * 60 + parseInt(a.hora.slice(3), 10) - min;
    const quem = a.nome + (a.servico ? " (" + a.servico + ")" : "");
    if (diff >= 0 && diff <= 15) out.push({ key: "ag-" + a.id + "-" + hoje, tipo: "agenda", texto: (diff === 0 ? "Agora: " : "Em " + diff + " min: ") + quem });
    else if (diff < 0 && diff >= -60) out.push({ key: "at-" + a.id + "-" + hoje, tipo: "atraso", texto: "Atrasado há " + (-diff) + " min: " + quem });
  });
  d.leads.forEach(l => {
    if (l.convertido || !l.pensarEm) return;
    const dd = diasDesde(l.pensarEm);
    if (dd >= 3) out.push({ key: "fu-" + l.id + "-" + hoje, tipo: "lead", texto: l.nome + " pediu para pensar há " + dd + " dias. Hora do follow-up." });
  });
  return out;
}
const SONS_AVISO = [["sino", "Sino"], ["alerta", "Alerta"], ["gota", "Gota"], ["off", "Desligado"]];
