  if (!/\[PERFIL\]/.test(txt) || !/\[FIM\]/.test(txt)) return null;
  const out = { vendas: [], leads: [], notas: [], agenda: [], pf: [], perfil: { servicos: [], expediente: {}, equipe: {} } };
  let sec = "", i = 0;
  const iso = (x) => /^\d{4}-\d{2}-\d{2}$/.test(x);
  const base = Date.now();
  for (const bruta of txt.split(/\r?\n/)) {
    const ln = bruta.trim();
    const m = ln.match(/^\[([A-Z]+)\]/);
    if (m) { sec = m[1]; if (sec === "FIM") break; continue; }
    if (!ln || !sec) continue;
    i++;
    if (sec === "PERFIL") {
      const k = ln.indexOf(":"); if (k < 0) continue;
      const ch = ln.slice(0, k).trim(), v = ln.slice(k + 1).trim();
      const P = out.perfil;
      if (ch === "nome") P.nome = v; else if (ch === "tratamento") P.trat = v; else if (ch === "empresa") P.empresa = v;
      else if (ch === "nicho") P.nicho = v; else if (ch === "nicho_tipo") P.nichoTipo = v; else if (ch === "cliente_ideal") P.cliente = v; else if (ch === "meta") P.meta = parseValor(v);
      else if (ch === "despesas_fixas") P.despesas = parseValor(v);
      else if (ch === "equipe") P.equipe.tem = v === "sim"; else if (ch === "equipe_qtd") P.equipe.qtd = parseInt(v, 10) || 0; else if (ch === "folha") P.equipe.folha = parseValor(v);
      else if (ch === "som") P.som = v !== "nao"; else if (ch === "tour_visto") out.tour = v === "sim";
      else if (ch === "dias") P.expediente.dias = v.split(",").map(Number).filter(n => n >= 0 && n <= 6);
      else if (ch === "inicio") P.expediente.ini = v; else if (ch === "fim") P.expediente.fim = v;
    } else {
      const c = ln.split("|").map(x => x.trim());
      if (sec === "SERVICOS" && c.length >= 3) out.perfil.servicos.push({ id: "s" + (base + i), nome: unescB(c[0]), preco: parseValor(c[1]), margem: parseValor(c[2]) });
      else if (sec === "VENDAS" && c.length >= 8 && iso(c[0]) && STATUS.includes(c[3])) out.vendas.push({ id: base + i, data: c[0], nome: unescB(c[1]), valor: parseValor(c[2]), status: c[3], servico: unescB(c[4]), origem: unescB(c[5]), pagamento: unescB(c[6]), lucro: parseValor(c[7]) });
      else if (sec === "LEADS" && c.length >= 7 && iso(c[0])) out.leads.push({ id: base + i, data: c[0], nome: unescB(c[1]), tel: unescB(c[2]), email: unescB(c[3]), serv: unescB(c[4]), msg: unescB(c[5]), convertido: c[6] === "sim", pensarEm: iso(c[7] || "") ? c[7] : "", ...(c[8] ? { origem: unescB(c[8]) } : {}), ...(["Quente", "Morno", "Aguardando Pix"].includes(c[9]) ? { etapa: c[9] } : {}), ...(c[10] && !isNaN(new Date(c[10]).getTime()) ? { ultimaInteracao: c[10] } : {}) });
      else if (sec === "NOTAS" && c.length >= 3) out.notas.push({ id: base + i, criado: c[0], titulo: unescB(c[1]), texto: unescB(c.slice(2).join(" | ")), editado: "" });
      else if (sec === "PROLABORE" && c.length >= 5 && iso(c[0]) && (c[1] === "entrada" || c[1] === "saida")) out.pf.push({ id: base + i, data: c[0], tipo: c[1], cat: unescB(c[2]), valor: parseValor(c[3]), desc: unescB(c.slice(4).join(" | ")) });
      else if (sec === "AGENDA" && c.length >= 6 && iso(c[0]) && STATUS_AG.includes(c[4])) out.agenda.push({ id: base + i, data: c[0], hora: c[1], nome: unescB(c[2]), servico: unescB(c[3]), status: c[4], obs: unescB(c[5]), criado: new Date().toISOString() });
    }
  }
  if (!out.perfil.expediente.dias) delete out.perfil.expediente; else out.perfil.expediente = { ...PERFIL0.expediente, ...out.perfil.expediente };
  return out;
}

