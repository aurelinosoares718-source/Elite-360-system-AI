const FILAS = {};
const sorteia = (chave, arr) => {
  let f = FILAS[chave];
  if (!f || f.length === 0) { const ult = FILAS[chave + "#u"]; f = arr.map((_, i) => i).sort(() => Math.random() - 0.5); if (f.length > 1 && f[f.length - 1] === ult) f.reverse(); FILAS[chave] = f; }
  const i = f.pop(); FILAS[chave + "#u"] = i; return arr[i];
};
const nPal = (t) => t.trim().split(/\s+/).filter(Boolean).length;
const baixa = (t) => t.replace(/^./, x => x.toLowerCase());
const subst = (t, o) => t.replace(/\{(\w+)\}/g, (_, k) => o[k] != null ? o[k] : "");
